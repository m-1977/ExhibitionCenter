<Window x:Class="ExhibitionCenter.Admin.AboutExhibitionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات معلومات عن المعرض"
        Width="1580"
        Height="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- BUTTON -->
        <Style x:Key="AboutButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Background"
                    Value="#241F18"/>

            <Setter Property="BorderBrush"
                    Value="#9A7432"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TEXTBOX -->
        <Style TargetType="TextBox">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#201C17"/>

            <Setter Property="BorderBrush"
                    Value="#665436"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Padding"
                    Value="12,3"/>

            <Setter Property="CaretBrush"
                    Value="#E2B258"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBorder"
                                        Property="BorderBrush"
                                        Value="#E2B258"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TAB -->
        <Style TargetType="TabItem">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="28,10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabBorder"
                                Margin="4"
                                CornerRadius="12"
                                Background="#201C17"
                                BorderBrush="#665436"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#392E20"/>

                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#E2B258"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border Margin="10"
            CornerRadius="30"
            BorderBrush="#CFA75B"
            BorderThickness="2"
            Background="#F411100E">

        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <TextBlock Grid.Row="0"
                       Text="إعدادات معلومات عن المعرض"
                       Foreground="#E7C478"
                       FontSize="31"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FlowDirection="RightToLeft"/>


            <!-- CONTENT -->
            <Grid Grid.Row="1"
                  Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- IMAGE -->
                <Border Grid.Column="0"
                        CornerRadius="22"
                        BorderBrush="#756143"
                        BorderThickness="1.3"
                        Background="#A0100E0C"
                        Padding="22">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="260"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="54"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="صورة معلومات المعرض"
                                   Foreground="#E7C478"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,12"/>


                        <Border Grid.Row="1"
                                x:Name="ImagePreviewFrame"
                                CornerRadius="18"
                                BorderBrush="#665436"
                                BorderThickness="1.3"
                                Background="#18140F">

                            <Grid>

                                <Rectangle x:Name="ImagePreviewSurface"
                                           RadiusX="17"
                                           RadiusY="17"
                                           Fill="#18140F"/>

                                <TextBlock x:Name="ImagePreviewPlaceholder"
                                           Text="لا توجد صورة"
                                           Foreground="#8E8373"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <Button Grid.Row="3"
                                Content="اختيار / تغيير الصورة"
                                Style="{StaticResource AboutButtonStyle}"
                                Click="ChooseImage_Click"/>


                        <Button Grid.Row="5"
                                Content="حذف الصورة"
                                Style="{StaticResource AboutButtonStyle}"
                                Click="RemoveImage_Click"/>


                        <Border Grid.Row="7"
                                Background="#40362A"/>


                        <TextBlock Grid.Row="9"
                                   Text="اللون الذهبي"
                                   Foreground="#E7C478"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>


                        <Grid Grid.Row="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AccentHexTextBox"
                                     Height="50"
                                     VerticalAlignment="Center"
                                     FlowDirection="LeftToRight"
                                     TextChanged="AccentHexTextBox_TextChanged"/>

                            <Border x:Name="AccentPreviewBorder"
                                    Grid.Column="2"
                                    CornerRadius="13"
                                    Background="#E2B258"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- TEXT -->
                <Border Grid.Column="2"
                        CornerRadius="22"
                        BorderBrush="#756143"
                        BorderThickness="1.3"
                        Background="#A0100E0C"
                        Padding="18">

                    <TabControl BorderThickness="0"
                                Background="Transparent"
                                SelectedIndex="0">

                        <!-- ================= ARABIC ================= -->
                        <TabItem Header="العربية">

                            <Grid Margin="6,10,6,4"
                                  FlowDirection="RightToLeft">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="75"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Row="0"
                                            Grid.ColumnSpan="3">

                                    <TextBlock Text="العنوان الذهبي — عربي"
                                               Foreground="#BEB19A"
                                               FontSize="15"
                                               Margin="0,0,0,5"
                                               HorizontalAlignment="Right"/>

                                    <TextBox x:Name="AboutTitleArTextBox"
                                             Height="48"/>

                                </StackPanel>


                                <!-- 1 -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 1"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note1TitleArTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note1BodyArTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 2 -->
                                <Border Grid.Row="2"
                                        Grid.Column="2"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 2"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note2TitleArTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note2BodyArTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 3 -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 3"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note3TitleArTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note3BodyArTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 4 -->
                                <Border Grid.Row="4"
                                        Grid.Column="2"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 4"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note4TitleArTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note4BodyArTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </TabItem>


                        <!-- ================= ENGLISH ================= -->
                        <TabItem Header="الإنجليزية">

                            <Grid Margin="6,10,6,4"
                                  FlowDirection="LeftToRight">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="75"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Row="0"
                                            Grid.ColumnSpan="3">

                                    <TextBlock Text="العنوان الذهبي — English"
                                               Foreground="#BEB19A"
                                               FontSize="15"
                                               Margin="0,0,0,5"/>

                                    <TextBox x:Name="AboutTitleEnTextBox"
                                             Height="48"/>

                                </StackPanel>


                                <!-- 1 -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 1 — English"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note1TitleEnTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note1BodyEnTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 2 -->
                                <Border Grid.Row="2"
                                        Grid.Column="2"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 2 — English"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note2TitleEnTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note2BodyEnTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 3 -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 3 — English"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note3TitleEnTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note3BodyEnTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>


                                <!-- 4 -->
                                <Border Grid.Row="4"
                                        Grid.Column="2"
                                        CornerRadius="14"
                                        BorderBrush="#51432E"
                                        BorderThickness="1"
                                        Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="الخانة 4 — English"
                                                   Foreground="#E7C478"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBox x:Name="Note4TitleEnTextBox"
                                                 Grid.Row="1"/>

                                        <TextBox x:Name="Note4BodyEnTextBox"
                                                 Grid.Row="3"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </TabItem>

                    </TabControl>

                </Border>

            </Grid>


            <!-- FOOTER -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Button Width="190"
                        Height="52"
                        Margin="0,0,14,0"
                        Content="إلغاء"
                        Style="{StaticResource AboutButtonStyle}"
                        Click="Cancel_Click"/>

                <Button Width="230"
                        Height="52"
                        Content="حفظ التغييرات"
                        Style="{StaticResource AboutButtonStyle}"
                        Click="Save_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>


