<Window x:Class="ExhibitionCenter.Admin.ClockSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الساعة وشاشة التوقف"
        Width="1400"
        Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#090806"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <Style x:Key="GoldButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#241F18"/>

            <Setter Property="BorderBrush"
                    Value="#CFA75B"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="24,12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#392E2418"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#E2B258"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="GoldToggleStyle"
               TargetType="CheckBox">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid Width="72"
                              Height="36">

                            <Border x:Name="Track"
                                    CornerRadius="18"
                                    Background="#2C261E"
                                    BorderBrush="#806C45"
                                    BorderThickness="1"/>

                            <Ellipse x:Name="Thumb"
                                     Width="28"
                                     Height="28"
                                     Fill="#E9E1D4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#CFA75B"/>

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="#F0D497"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,4,0"/>

                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="#11100E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Background"
                    Value="#17130F"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#806C45"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Padding"
                    Value="12,4"/>

        </Style>



        <Style x:Key="IdleOptionStyle"
               TargetType="RadioButton">

            <Setter Property="Foreground"
                    Value="#D8D0C3"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Margin"
                    Value="6,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="OptionBorder"
                                Height="52"
                                CornerRadius="13"
                                Background="#17130F"
                                BorderBrush="#705F3C"
                                BorderThickness="1.2">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#CFA75B"/>

                                <Setter TargetName="OptionBorder"
                                        Property="Background"
                                        Value="#241F18"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="OptionBorder"
                                        Property="Background"
                                        Value="#A77B32"/>

                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#F0D497"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Background"
                    Value="#17130F"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="CaretBrush"
                    Value="#E2B258"/>

            <Setter Property="BorderBrush"
                    Value="#806C45"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Padding"
                    Value="14,8"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <Border Margin="18"
            CornerRadius="26"
            BorderBrush="#A98036"
            BorderThickness="1.5"
            Background="#F20D0B09">

        <Grid Margin="42">

            <Grid.RowDefinitions>

                <RowDefinition Height="105"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="85"/>

            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Grid>

                <StackPanel HorizontalAlignment="Right">

                    <TextBlock Text="الساعة وشاشة التوقف"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="إعداد شاشة الساعة التي تظهر عند عدم استخدام المعرض"
                               Foreground="#AFA48F"
                               FontSize="17"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>


            <!-- CONTENT -->

            <Grid Grid.Row="1"
                  Margin="0,18,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.05*"/>

                    <ColumnDefinition Width="35"/>

                    <ColumnDefinition Width="0.95*"/>

                </Grid.ColumnDefinitions>


                <!-- SETTINGS -->

                <Border Grid.Column="0"
                        CornerRadius="22"
                        Background="#CC14110D"
                        BorderBrush="#705F3C"
                        BorderThickness="1.3"
                        Padding="30">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="90"/>

                            <RowDefinition Height="110"/>

                            <RowDefinition Height="90"/>

                            <RowDefinition Height="110"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- ENABLE -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="95"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="تفعيل شاشة الساعة"
                                           Foreground="White"
                                           FontSize="21"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تظهر الساعة تلقائياً بعد فترة من عدم الاستخدام"
                                           Foreground="#AFA48F"
                                           FontSize="15"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <CheckBox x:Name="EnableClockToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource GoldToggleStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Grid>


                        <!-- IDLE -->

                        <StackPanel Grid.Row="1">

                            <TextBlock Text="بدء شاشة الساعة بعد"
                                       Foreground="#E2B258"
                                       FontSize="17"
                                       Margin="0,0,0,10"/>

                            <UniformGrid Columns="4"
                                         FlowDirection="RightToLeft">

                                <RadioButton x:Name="Idle1Option"
                                             Content="1 دقيقة"
                                             GroupName="IdleTime"
                                             Style="{StaticResource IdleOptionStyle}"/>

                                <RadioButton x:Name="Idle3Option"
                                             Content="3 دقائق"
                                             GroupName="IdleTime"
                                             Style="{StaticResource IdleOptionStyle}"/>

                                <RadioButton x:Name="Idle5Option"
                                             Content="5 دقائق"
                                             GroupName="IdleTime"
                                             Style="{StaticResource IdleOptionStyle}"/>

                                <RadioButton x:Name="Idle10Option"
                                             Content="10 دقائق"
                                             GroupName="IdleTime"
                                             Style="{StaticResource IdleOptionStyle}"/>

                            </UniformGrid>

                        </StackPanel>


                        <!-- WEATHER -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="95"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="عرض الطقس ودرجة الحرارة"
                                           Foreground="White"
                                           FontSize="21"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="إظهار حالة الطقس بجانب الساعة"
                                           Foreground="#AFA48F"
                                           FontSize="15"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <CheckBox x:Name="ShowWeatherToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource GoldToggleStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Grid>


                        <!-- CITY -->

                        <StackPanel Grid.Row="3">

                            <TextBlock Text="المدينة"
                                       Foreground="#E2B258"
                                       FontSize="17"
                                       Margin="0,0,0,10"/>

                            <TextBox x:Name="CityTextBox"/>

                        </StackPanel>


                        <Border Grid.Row="4"
                                Margin="0,12,0,0"
                                CornerRadius="14"
                                Background="#18140F"
                                BorderBrush="#40351F"
                                BorderThickness="1"
                                Padding="18">

                            <TextBlock Text="الوقت والتاريخ يعملان مباشرة من Windows. سيتم ربط الطقس بالإنترنت في الخطوة التالية."
                                       Foreground="#BEB4A1"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- PREVIEW -->

                <Border Grid.Column="2"
                        CornerRadius="22"
                        Background="#080706"
                        BorderBrush="#806C45"
                        BorderThickness="1.5">

                    <Grid>

                        <TextBlock Text="معاينة"
                                   Foreground="#8F826B"
                                   FontSize="15"
                                   Margin="20"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>


                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="500">

                            <TextBlock Text="▱"
                                       Foreground="#D9B96F"
                                       FontSize="68"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="متحف"
                                       Foreground="#D9B96F"
                                       FontSize="44"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,25"/>

                            <TextBlock Text="10:24"
                                       Foreground="#EAD19A"
                                       FontSize="120"
                                       FontWeight="Light"
                                       HorizontalAlignment="Center"
                                       FlowDirection="LeftToRight"/>

                            <TextBlock Text="الأحد، 14 سبتمبر 2026"
                                       Foreground="#D5C6AA"
                                       FontSize="25"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>

                        </StackPanel>


                        <StackPanel HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Margin="28">

                            <TextBlock Text="☀"
                                       Foreground="#E2B258"
                                       FontSize="30"
                                       Margin="0,0,12,0"/>

                            <StackPanel>

                                <TextBlock Text="34°C"
                                           Foreground="#E9D4A4"
                                           FontSize="23"
                                           FlowDirection="LeftToRight"/>

                                <TextBlock Text="الدوحة"
                                           Foreground="#AFA48F"
                                           FontSize="15"/>

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- BOTTOM BUTTONS -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="180"/>

                </Grid.ColumnDefinitions>


                <Button Grid.Column="1"
                        Content="إلغاء"
                        Style="{StaticResource GoldButtonStyle}"
                        Click="Cancel_Click"/>


                <Button Grid.Column="3"
                        Content="حفظ"
                        Background="#B98C3D"
                        Style="{StaticResource GoldButtonStyle}"
                        Click="Save_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>

