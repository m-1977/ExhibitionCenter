<Window x:Class="ExhibitionCenter.Admin.StartupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التشغيل مع Windows"
        Width="1050"
        Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0D0C0A"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="GoldButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#241F18"/>
            <Setter Property="BorderBrush" Value="#CFA75B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="86" Height="44">
                            <Border x:Name="Track"
                                    Background="#2C261E"
                                    BorderBrush="#806C45"
                                    BorderThickness="1.5"
                                    CornerRadius="22"/>
                            <Ellipse x:Name="Thumb"
                                     Width="34" Height="34"
                                     Fill="#E9E1D4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#CFA75B"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#11100E"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24"
            CornerRadius="28"
            Background="#12100D"
            BorderBrush="#A8CFA75B"
            BorderThickness="2"
            Padding="48">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="التشغيل مع Windows"
                       Foreground="#E7C478"
                       FontSize="34"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Row="1"
                       Text="تشغيل المتحف تلقائياً عند تسجيل الدخول إلى Windows"
                       Foreground="#C7BBA7"
                       FontSize="19"
                       Margin="0,15,0,32"/>

            <Border Grid.Row="2"
                    CornerRadius="20"
                    Background="#1C1812"
                    BorderBrush="#705F3C"
                    BorderThickness="1.5"
                    Padding="32"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تشغيل المتحف تلقائياً مع Windows"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="StartupStatusText"
                                   Text="غير مفعّل"
                                   Foreground="#BDAE92"
                                   FontSize="18"
                                   Margin="0,15,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="StartupToggle"
                              Grid.Column="1"
                              Style="{StaticResource GoldToggleStyle}"
                              VerticalAlignment="Center"
                              Margin="30,0,0,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="حفظ"
                        Width="180" Height="62"
                        Background="#B98C3D"
                        Style="{StaticResource GoldButtonStyle}"
                        Click="Save_Click"/>
                <Button Content="إلغاء"
                        Width="180" Height="62"
                        Margin="18,0,0,0"
                        Style="{StaticResource GoldButtonStyle}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
