<Window x:Class="ExhibitionCenter.Admin.TextSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحرير النصوص"
        Width="1260"
        Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0D0C0A"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- PROJECT BUTTON -->
        <Style x:Key="ProjectButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="MinWidth"
                    Value="170"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#241F18"/>

            <Setter Property="BorderBrush"
                    Value="#A8CFA75B"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A2F20"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#E3BD67"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4A3924"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TEXT BOX -->
        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#201C16"/>

            <Setter Property="BorderBrush"
                    Value="#8FCFA75B"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="Padding"
                    Value="15,8"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- VERTICAL CATEGORY CARD -->
        <Style x:Key="CategorySliderItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

            <Setter Property="Focusable"
                    Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="CardBorder"
                                Height="94"
                                CornerRadius="18"
                                Padding="14"
                                Background="#241F18"
                                BorderBrush="#65CFA75B"
                                BorderThickness="1.2">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#30281D"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#352A1D"/>

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#E8BE60"/>

                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2.2"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border Margin="12"
            Padding="26"
            CornerRadius="26"
            BorderBrush="#75CFA75B"
            BorderThickness="1.4"
            Background="#0D0C0A">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="110"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="90"/>

            </Grid.RowDefinitions>


            <!-- MAIN TITLE -->

            <Border Grid.Row="0"
                    CornerRadius="20"
                    BorderBrush="#8FCFA75B"
                    BorderThickness="1.5"
                    Background="#181510"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="220"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="العنوان الرئيسي"
                               Foreground="#E7C478"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>


                    <TextBox x:Name="MainTitleTextBox"
                             Grid.Column="1"
                             Margin="20,0,0,0"
                             FlowDirection="RightToLeft"
                             TextAlignment="Right"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             Padding="18,0"/>

                </Grid>

            </Border>


            <!-- BODY -->

            <Grid Grid.Row="1"
                  Margin="0,25,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="26"/>

                    <ColumnDefinition Width="350"/>

                </Grid.ColumnDefinitions>


                <!-- EDITOR -->

                <Border Grid.Column="0"
                        CornerRadius="22"
                        BorderBrush="#70CFA75B"
                        BorderThickness="1.5"
                        Background="#15120E"
                        Padding="28">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="55"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock Text="تحرير نص وصورة القسم"
                                   Foreground="#E7C478"
                                   FontSize="27"
                                   FontWeight="SemiBold"/>


                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="25"/>

                                <ColumnDefinition Width="300"/>

                            </Grid.ColumnDefinitions>


                            <!-- TEXT -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="اسم القسم"
                                           Foreground="#BEB19A"
                                           FontSize="17"
                                           Margin="0,0,0,8"/>


                                <TextBox Text="{Binding SelectedItem.Name,
                                                       ElementName=CategoryList,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Right"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="18,0"/>


                                <TextBlock Text="النص أسفل اسم القسم"
                                           Foreground="#BEB19A"
                                           FontSize="17"
                                           Margin="0,24,0,8"/>


                                <TextBox Text="{Binding SelectedItem.Subtitle,
                                                       ElementName=CategoryList,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Right"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="18,0"/>


                                <TextBlock Text="مثال: الهواتف / التواصل عبر الأجيال"
                                           Foreground="#817867"
                                           FontSize="14"
                                           Margin="0,14,0,0"/>

                            </StackPanel>


                            <!-- COVER IMAGE -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="صورة القسم الرئيسية"
                                           Foreground="#BEB19A"
                                           FontSize="17"
                                           Margin="0,0,0,8"/>


                                <Border Height="205"
                                        CornerRadius="18"
                                        BorderBrush="#85CFA75B"
                                        BorderThickness="1.5"
                                        Background="#19150F"
                                        ClipToBounds="True">

                                    <Grid>

                                        <Image Source="{Binding SelectedItem.ImagePath,
                                                                ElementName=CategoryList}"
                                               Stretch="UniformToFill"/>


                                        <Border Background="#25100D09">

                                            <TextBlock Text="لا توجد صورة"
                                                       Foreground="#968A75"
                                                       FontSize="17"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding SelectedItem.ImagePath,
                                                                                          ElementName=CategoryList}"
                                                                         Value="">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Border>

                                    </Grid>

                                </Border>


                                <Button Margin="0,14,0,0"
                                        Style="{StaticResource ProjectButtonStyle}"
                                        Content="اختيار / تغيير الصورة"
                                        Click="ChooseImage_Click"/>


                                <Button Margin="0,10,0,0"
                                        Style="{StaticResource ProjectButtonStyle}"
                                        Content="حذف الصورة"
                                        Click="RemoveImage_Click"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- VERTICAL CATEGORY SLIDER -->

                <Border Grid.Column="2"
                        CornerRadius="22"
                        BorderBrush="#70CFA75B"
                        BorderThickness="1.5"
                        Background="#15120E"
                        Padding="14">

                    <ListBox x:Name="CategoryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CategorySliderItemStyle}"
                             SelectedIndex="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.PanningMode="VerticalOnly"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="CategoryList_MouseDown"
                             PreviewMouseMove="CategoryList_MouseMove"
                             PreviewMouseLeftButtonUp="CategoryList_MouseUp"
                             PreviewMouseWheel="CategoryList_MouseWheel">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="64"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="24"
                                            BorderBrush="#9FCFA75B"
                                            BorderThickness="1.3"
                                            Background="#17130F"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="22"
                                                   Foreground="#E1BC68"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="#AFA48F"
                                                   FontSize="14"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Border>

            </Grid>


            <!-- BUTTONS -->

            <Grid Grid.Row="2"
                  Margin="0,20,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Width="155"
                            Margin="0,0,10,0"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="+ إضافة قسم"
                            Click="AddCategory_Click"/>
                    <!-- CATEGORY ORDER BUTTONS START -->

                    <Button Width="155"
                            Margin="0,0,10,0"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="↑ لأعلى"
                            Click="MoveCategoryUp_Click"/>

                    <Button Width="155"
                            Margin="0,0,10,0"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="↓ لأسفل"
                            Click="MoveCategoryDown_Click"/>

                    <!-- CATEGORY ORDER BUTTONS END -->



                    <Button Width="155"
                            Margin="0,0,10,0"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="حذف القسم"
                            Click="DeleteCategory_Click"/>
<Button Width="155"
                            Margin="0,0,10,0"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="إلغاء"
                            Click="Cancel_Click"/>


                    <Button Width="155"
                            Style="{StaticResource ProjectButtonStyle}"
                            Content="حفظ التغييرات"
                            Click="Save_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>







