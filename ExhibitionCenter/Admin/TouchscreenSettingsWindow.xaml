<Window x:Class="ExhibitionCenter.Admin.TouchscreenSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شاشة اللمس"
        Width="780"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <Style x:Key="MuseumButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="MinWidth"
                    Value="160"/>

            <Setter Property="Margin"
                    Value="8,0"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#241F18"/>

            <Setter Property="BorderBrush"
                    Value="#80CFA75B"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#332A20"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CFA75B"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="MuseumToggleStyle"
               TargetType="ToggleButton">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Grid Width="108"
                              Height="50">

                            <Border x:Name="Track"
                                    CornerRadius="25"
                                    Background="#2C261E"
                                    BorderBrush="#806C45"
                                    BorderThickness="1.5"/>

                            <Ellipse x:Name="Thumb"
                                     Width="38"
                                     Height="38"
                                     Margin="6"
                                     Fill="#E7D7B0"
                                     HorizontalAlignment="Left"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#CFA75B"/>

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="#E7C879"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="#14110D"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="#E7C879"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border Margin="10"
            CornerRadius="28"
            Background="#12100D"
            BorderBrush="#806C45"
            BorderThickness="1.5">

        <Grid Margin="34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0">

                <TextBlock Text="شاشة اللمس"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="إعداد مؤشر الماوس لواجهة الزائر"
                           Foreground="#B8A98A"
                           FontSize="16"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <Border Grid.Row="2"
                    CornerRadius="20"
                    Background="#1C1812"
                    BorderBrush="#665437"
                    BorderThickness="1.2"
                    Padding="30">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="وضع شاشة اللمس"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="عند التفعيل يتم إخفاء مؤشر الماوس في واجهة المتحف. يبقى المؤشر ظاهراً داخل لوحة الإدارة."
                                   Foreground="#C7B99A"
                                   FontSize="17"
                                   TextWrapping="Wrap"
                                   Margin="0,12,20,0"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <ToggleButton x:Name="TouchscreenToggle"
                                      Style="{StaticResource MuseumToggleStyle}"/>

                        <TextBlock Text="ON / OFF"
                                   Foreground="#CFA75B"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="حفظ"
                        Background="#B98C3D"
                        Style="{StaticResource MuseumButtonStyle}"
                        Click="Save_Click"/>

                <Button Content="إلغاء"
                        Style="{StaticResource MuseumButtonStyle}"
                        Click="Cancel_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
