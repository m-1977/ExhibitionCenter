                            RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>

                            <ScaleTransform x:Name="AboutPopupScale"
                                            ScaleX="1"
                                            ScaleY="1"/>

                        </Border.RenderTransform>


                        <Grid Margin="42"
                              FlowDirection="LeftToRight">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="610"/>

                                <ColumnDefinition Width="55"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- X CLOSE ONLY -->

                            <Button x:Name="AboutCloseButton"
                                    Width="58"
                                    Height="58"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#261F18"
                                    BorderBrush="#E2B258"
                                    BorderThickness="1.5"
                                    Foreground="#E2B258"
                                    FontSize="27"
                                    Content="✕"
                                    Cursor="Hand"
                                    Click="AboutClose_Click"
                                    Panel.ZIndex="10">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="CloseBorder"
                                                CornerRadius="29"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>


                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#44331E"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>


                            <!-- LEFT IMAGE -->

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,45,0,0">

                                <Border x:Name="AboutImageFrame"
                                        Height="405"
                                        CornerRadius="25"
                                        BorderBrush="#E2B258"
                                        BorderThickness="2"
                                        Background="#18130F">

                                    <Grid>

                                        <Rectangle x:Name="AboutImageSurface"
                                                   RadiusX="22"
                                                   RadiusY="22"
                                                   Fill="#18130F"/>


                                        <StackPanel x:Name="AboutImagePlaceholder"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="ⓘ"
                                                       Foreground="#E2B258"
                                                       FontSize="68"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Exhibition Center"
                                                       Foreground="#9D917F"
                                                       FontSize="20"
                                                       Margin="0,12,0,0"
                                                       HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Grid>


                            <!-- RIGHT CONTENT -->

                            <Grid Grid.Column="2"
                                  Margin="0,14,0,14">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="105"/>

                                    <RowDefinition Height="2"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <StackPanel>

                                    <TextBlock Text="ⓘ"
                                               x:Name="AboutInfoIcon"
                                               Foreground="#E2B258"
                                               FontSize="26"
                                               HorizontalAlignment="Right"/>


                                    <TextBlock x:Name="AboutTitleText"
                                               Text="معلومات عن المعرض"
                                               Foreground="#E2B258"
                                               FontSize="38"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Right"
                                               FlowDirection="RightToLeft"/>

                                </StackPanel>


                                <Border Grid.Row="1"
                                        x:Name="AboutGoldLine"
                                        Background="#E2B258"/>


                                <Grid Grid.Row="2"
                                      Margin="0,28,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="20"/>

                                    </Grid.ColumnDefinitions>


                                    <ScrollViewer x:Name="AboutTextScrollViewer"
                                                  Grid.Column="0"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly"
                                                  PanningDeceleration="0.001"
                                                  ScrollChanged="AboutTextScrollViewer_ScrollChanged">

                                        <StackPanel x:Name="AboutNotesPanel"
                                                    Margin="8,0,18,20"/>

                                    </ScrollViewer>


                                    <!-- CUSTOM GOLD VERTICAL SLIDER -->

                                    <ScrollBar x:Name="AboutScrollBar"
                                               Grid.Column="1"
                                               Orientation="Vertical"
                                               Width="8"
                                               Minimum="0"
                                               Foreground="#E2B258"
                                               Background="#30271E"
                                               ValueChanged="AboutScrollBar_ValueChanged">

                                        <ScrollBar.Template>

                                            <ControlTemplate TargetType="ScrollBar">

                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">

                                                    <Track x:Name="PART_Track"
                                                           Orientation="Vertical"
                                                           IsDirectionReversed="True">

                                                        <Track.DecreaseRepeatButton>

                                                            <RepeatButton
                                                                Command="{x:Static ScrollBar.PageUpCommand}"
                                                                Opacity="0"/>

                                                        </Track.DecreaseRepeatButton>


                                                        <Track.Thumb>

                                                            <Thumb Background="{TemplateBinding Foreground}"
                                                                   MinHeight="55">

                                                                <Thumb.Template>

                                                                    <ControlTemplate TargetType="Thumb">

                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"/>

                                                                    </ControlTemplate>

                                                                </Thumb.Template>

                                                            </Thumb>

                                                        </Track.Thumb>


                                                        <Track.IncreaseRepeatButton>

                                                            <RepeatButton
                                                                Command="{x:Static ScrollBar.PageDownCommand}"
                                                                Opacity="0"/>

                                                        </Track.IncreaseRepeatButton>

                                                    </Track>

                                                </Border>

                                            </ControlTemplate>

                                        </ScrollBar.Template>

                                    </ScrollBar>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Viewbox>

        </Grid>

        <!-- ABOUT EXHIBITION OVERLAY END -->

        <!-- ================================================= -->
        <!-- CLOCK / IDLE SCREEN OVERLAY -->
        <!-- ================================================= -->

        <Grid x:Name="ClockScreenOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="20000"
              Background="#FF070605">

            <Viewbox Stretch="UniformToFill">

                <Grid Width="1920"
                      Height="1080"
                      Background="#070605">

                    <!-- Existing museum atmosphere -->
                    <Image Source="Assets/Backgrounds/MuseumBackground.png"
                           Stretch="UniformToFill"
                           Opacity="0.16"/>

                    <!-- Heavy dark museum layer -->
                    <Rectangle>

                        <Rectangle.Fill>

                            <RadialGradientBrush Center="0.5,0.43"
                                                 GradientOrigin="0.5,0.43"
                                                 RadiusX="0.78"
                                                 RadiusY="0.86">

                                <GradientStop Color="#B80A0907"
                                              Offset="0"/>

                                <GradientStop Color="#EE070605"
                                              Offset="0.62"/>

                                <GradientStop Color="#FF030302"
                                              Offset="1"/>

                            </RadialGradientBrush>

                        </Rectangle.Fill>

                    </Rectangle>


                    <!-- Thin museum gold frame -->
                    <Border Margin="34"
                            CornerRadius="30"
                            BorderBrush="#755525"
                            BorderThickness="1.4"/>


                    <!-- WEATHER PLACEHOLDER - REAL WEATHER NEXT STEP -->
                    <StackPanel x:Name="ClockWeatherPanel"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,58,72,0"
                                FlowDirection="LeftToRight">

                        <TextBlock x:Name="ClockWeatherIcon"
                                   Text="☀"
                                   Foreground="#D8B76D"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="42"
                                   VerticalAlignment="Center"
                                   Margin="0,0,18,0"/>

                        <Border Width="1"
                                Height="54"
                                Background="#806A42"
                                Margin="0,0,18,0"/>

                        <StackPanel>

                            <TextBlock x:Name="ClockTemperatureText"
                                       Text="--°C"
                                       Foreground="#E6D0A0"
                                       FontSize="31"
                                       FontWeight="Light"/>

                            <TextBlock x:Name="ClockWeatherCityText"
                                       Text="الدوحة"
                                       Foreground="#AD9C7D"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- MAIN CLOCK -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,-55,0,0">

                        <!-- Museum icon -->
                        <Grid Width="122"
                              Height="90"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10">

                            <Polygon Points="12,30 61,5 110,30"
                                     Stroke="#CFA75B"
                                     StrokeThickness="5"
                                     Fill="Transparent"/>

                            <Rectangle Width="102"
                                       Height="6"
                                       Fill="#CFA75B"
                                       VerticalAlignment="Top"
                                       Margin="0,29,0,0"/>

                            <UniformGrid Columns="4"
                                         Width="80"
                                         Height="42"
                                         Margin="0,37,0,0"
                                         VerticalAlignment="Top">

                                <Rectangle Fill="#CFA75B"
                                           Margin="5,0"/>

                                <Rectangle Fill="#CFA75B"
                                           Margin="5,0"/>

                                <Rectangle Fill="#CFA75B"
                                           Margin="5,0"/>

                                <Rectangle Fill="#CFA75B"
                                           Margin="5,0"/>

                            </UniformGrid>

                            <Rectangle Width="108"
                                       Height="6"
                                       Fill="#CFA75B"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2"/>

                        </Grid>


                        <!-- Museum title -->
                        <Grid Width="680"
                              Margin="0,0,0,42">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="240"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Height="1"
                                    Background="#85652F"
                                    VerticalAlignment="Center"
                                    Margin="0,10,20,0"/>

                            <TextBlock Grid.Column="1"
                                       Text="متحف"
                                       Foreground="#D8B76D"
                                       FontSize="57"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="#85652F"
                                    VerticalAlignment="Center"
                                    Margin="20,10,0,0"/>

                        </Grid>


                        <!-- Time -->
                        <StackPanel Orientation="Horizontal"
                                    FlowDirection="LeftToRight"
                                    HorizontalAlignment="Center">

                            <TextBlock x:Name="ClockTimeText"
                                       Text="10:24"
                                       Foreground="#E4C681"
                                       FontFamily="Segoe UI"
                                       FontSize="235"
                                       FontWeight="Light"
                                       LineHeight="240"/>

                            <TextBlock x:Name="ClockAmPmText"
                                       Text="AM"
                                       Foreground="#D3B473"
                                       FontFamily="Segoe UI"
                                       FontSize="48"
                                       FontWeight="Light"
                                       VerticalAlignment="Bottom"
                                       Margin="24,0,0,37"/>

                        </StackPanel>


                        <!-- Date -->
                        <TextBlock x:Name="ClockDateText"
                                   Text="الأحد، 14 سبتمبر 2026"
                                   Foreground="#D0C2A7"
                                   FontSize="39"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   Margin="0,15,0,0"
                                   FlowDirection="RightToLeft"/>

                    </StackPanel>

                </Grid>

            </Viewbox>

        </Grid>

</Grid>

</Window>







































