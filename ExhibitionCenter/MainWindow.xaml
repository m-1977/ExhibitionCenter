<Window x:Class="ExhibitionCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exhibition Center"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        FontFamily="Segoe UI"
        Loaded="MainWindow_LoadedAllSettings"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>

        <!-- Main gold card -->
        <Style x:Key="MuseumCardButton"
       TargetType="Button">

    <Setter Property="Background"
            Value="Transparent"/>

    <Setter Property="BorderThickness"
            Value="0"/>

    <Setter Property="Cursor"
            Value="Hand"/>

    <Setter Property="Padding"
            Value="0"/>

    <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

    <Setter Property="VerticalContentAlignment"
            Value="Stretch"/>

    <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>


    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border x:Name="CardBorder"
                        CornerRadius="26"
                        BorderBrush="#CFA75B"
                        BorderThickness="2"
                        Background="#D9181714">

                    <ContentPresenter
                        Margin="0"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                </Border>


                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter TargetName="CardBorder"
                                Property="BorderBrush"
                                Value="#FFD987"/>

                        <Setter TargetName="CardBorder"
                                Property="Background"
                                Value="#E6252119"/>

                    </Trigger>


                    <Trigger Property="IsPressed"
                             Value="True">

                        <Setter TargetName="CardBorder"
                                Property="Background"
                                Value="#F0342A1D"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>

    </Setter>

</Style>


        <!-- Camera thumbnails -->
        <Style x:Key="CameraThumbnailStyle"
               TargetType="ListBoxItem">

            <Setter Property="Width" Value="238"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ThumbnailBorder"
                                CornerRadius="17"
                                BorderBrush="#70CFA75B"
                                BorderThickness="2"
                                Background="#CC11100E">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThumbnailBorder"
                                        Property="BorderBrush"
                                        Value="#FFD987"/>

                            </Trigger>


                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ThumbnailBorder"
                                        Property="BorderBrush"
                                        Value="#FFD36A"/>

                                <Setter TargetName="ThumbnailBorder"
                                        Property="BorderThickness"
                                        Value="4"/>

                                <Setter TargetName="ThumbnailBorder"
                                        Property="Background"
                                        Value="#E6262015"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- Rounded pill button -->
        <Style x:Key="MuseumPillButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#CC0B0B0B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#9CCFA75B"
                                BorderThickness="2"
                                CornerRadius="32"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PillBorder"
                                        Property="BorderBrush"
                                        Value="#FFD77D"/>

                                <Setter TargetName="PillBorder"
                                        Property="Background"
                                        Value="#E51A1712"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="PillBorder"
                                        Property="Background"
                                        Value="#F02D2418"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- Circular navigation arrow -->
        <Style x:Key="MuseumCircleButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="68"/>

            <Setter Property="Height"
                    Value="68"/>

            <Setter Property="Background"
                    Value="#D10B0B0B"/>

            <Setter Property="Foreground"
                    Value="#FFD67B"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CircleBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="34"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D7A84F"
                                BorderThickness="2">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CircleBorder"
                                        Property="BorderBrush"
                                        Value="#FFE09A"/>

                                <Setter TargetName="CircleBorder"
                                        Property="Background"
                                        Value="#E7282118"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CircleBorder"
                                        Property="Background"
                                        Value="#F03A2D1C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>
    
        <!-- PROJECT CONTROL BUTTON STYLE START -->

        <Style x:Key="ProjectControlButtonStyle"
               TargetType="Button">

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Background"
                    Value="#241F18"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#8FCFA75B"/>

            <Setter Property="BorderThickness"
                    Value="1.4"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- Mouse hover -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#33291D"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#E3BD67"/>

                            </Trigger>


                            <!-- Pressed -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#493820"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#F1CD77"/>

                            </Trigger>


                            <!-- Keyboard / touch focus -->
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#DDB65F"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- PROJECT CONTROL BUTTON STYLE END -->

    </Window.Resources>


    <Grid>

        <!-- Museum background -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"/>


        <!-- Dark cinematic overlay -->
        <Border>

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">

                    <GradientStop Color="#58000000"
                                  Offset="0"/>

                    <GradientStop Color="#26000000"
                                  Offset="0.45"/>

                    <GradientStop Color="#88000000"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>


        <!-- ================================================= -->
        <!-- HOME -->
        <!-- ================================================= -->

        <Viewbox x:Name="HomeContent"
                 Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080">

                <Grid.RowDefinitions>

                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>

                </Grid.RowDefinitions>


                <!-- Header -->

                <Grid Grid.Row="0"
                      Margin="55,35,55,0">


                    <!-- Language -->

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC0D0D0D"
                            BorderBrush="#8FCFA75B"
                            BorderThickness="1.5"
                            CornerRadius="30"
                            Padding="20,10">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🌐"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="24"
                                       Foreground="White"
                                       Margin="0,0,12,0"/>

                            <TextBlock x:Name="HomeLanguageText"
                                       Text="العربية  |  English"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="LanguageSwitch_MouseLeftButtonUp"
                                       FontSize="20"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>


                    <!-- Title -->

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="رحلة عبر تاريخ التقنية"
                                   x:Name="AdminHotspot"
                                   Foreground="White"
                                   MouseLeftButtonDown="AdminHotspot_MouseLeftButtonDown"
                                   MouseLeftButtonUp="AdminHotspot_MouseLeftButtonUp"
                                   MouseLeave="AdminHotspot_MouseLeave"
                                   TouchDown="AdminHotspot_TouchDown"
                                   TouchUp="AdminHotspot_TouchUp"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   FlowDirection="RightToLeft"/>

                        <Border Width="180"
                                Height="2"
                                Background="#CFA75B"
                                Margin="0,16,0,16"/>

                        <TextBlock Text="اختر القسم الذي ترغب في استكشافه"
                                   Foreground="#D8D0C3"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   FlowDirection="RightToLeft"/>

                    </StackPanel>

                </Grid>
                <!-- ================================================= -->
                <!-- DYNAMIC CATEGORY TOUCH SLIDER -->
                <!-- ================================================= -->

                <ScrollViewer x:Name="CategoryScrollViewer"
                              Grid.Row="1"
                              Width="1720"
                              Height="500"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              PanningRatio="1"
                              PanningDeceleration="0.001"
                              CanContentScroll="False"

                              PreviewMouseLeftButtonDown="CategorySlider_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CategorySlider_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CategorySlider_PreviewMouseLeftButtonUp"
                              PreviewMouseWheel="CategorySlider_PreviewMouseWheel">

                    <ItemsControl x:Name="CategoryStrip">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>


                        <ItemsControl.ItemTemplate>

    <DataTemplate>

        <Button Width="400"
                Height="470"
                Margin="15"
                Style="{StaticResource MuseumCardButton}"
                Tag="{Binding Key}"
                Click="OpenCategoryCard_Click">

            <Grid ClipToBounds="True">

                <!-- COVER IMAGE -->

                <Rectangle Margin="0"
           RadiusX="23"
           RadiusY="23"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           IsHitTestVisible="False">

    <Rectangle.Style>

        <Style TargetType="Rectangle">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding ImagePath}"
                             Value="">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Rectangle.Style>


    <Rectangle.Fill>

        <ImageBrush ImageSource="{Binding ImagePath}"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center"/>

    </Rectangle.Fill>

</Rectangle>

<!-- DARK CINEMATIC GRADIENT -->

                <Rectangle RadiusX="23" RadiusY="23" IsHitTestVisible="False">

                    <Rectangle.Fill>

                        <LinearGradientBrush StartPoint="0.5,0"
                                             EndPoint="0.5,1">

                            <GradientStop Color="#09000000"
                                          Offset="0"/>

                            <GradientStop Color="#25000000"
                                          Offset="0.42"/>

                            <GradientStop Color="#E8100D09"
                                          Offset="0.74"/>

                            <GradientStop Color="#FA0C0A08"
                                          Offset="1"/>

                        </LinearGradientBrush>

                    </Rectangle.Fill>

                </Rectangle>


                <!-- FALLBACK ICON WHEN NO COVER IMAGE -->

                <Border Width="110"
                        Height="110"
                        CornerRadius="55"
                        BorderBrush="#CFA75B"
                        BorderThickness="1.5"
                        Background="#33CFA75B"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,90">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding ImagePath}"
                                             Value="">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>


                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe UI Emoji"
                               FontSize="54"
                               Foreground="#E7C478"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- NAME + SUBTITLE -->

                <StackPanel VerticalAlignment="Bottom"
                            Margin="28,0,28,86">

                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="#F2D28A"
                               FontSize="38"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               FlowDirection="RightToLeft"
                               TextTrimming="CharacterEllipsis"/>


                    <TextBlock Text="{Binding DisplaySubtitle}"
                               Foreground="#F1ECE2"
                               FontSize="20"
                               Margin="0,9,0,0"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               FlowDirection="RightToLeft"
                               TextTrimming="CharacterEllipsis"/>

                </StackPanel>


                <!-- OPEN BUTTON -->

                <Border Width="58"
                        Height="58"
                        CornerRadius="29"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18"
                        Background="#B518140F"
                        BorderBrush="#E2B65E"
                        BorderThickness="2">

                    <TextBlock Text="→"
                               Foreground="White"
                               FontSize="31"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FlowDirection="LeftToRight"/>

                </Border>

            </Grid>

        </Button>

    </DataTemplate>

</ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                


                <!-- Footer -->

                <Grid Grid.Row="2"
                      Margin="45,0,45,35">

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#CC0D0D0D"
                            BorderBrush="#8FCFA75B"
                            BorderThickness="1.5"
                            CornerRadius="32"
                            Padding="20,12">

                        <TextBlock x:Name="HomeAboutText"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="AboutExhibition_Click" Text="▦   معلومات عن المعرض"
                                   Foreground="White"
                                   FontSize="20"/>

                    </Border>


                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#CC0D0D0D"
                            BorderBrush="#8FCFA75B"
                            BorderThickness="1.5"
                            CornerRadius="32"
                            Padding="24,12">

                        <TextBlock x:Name="HomeTouchHintText" Text="☝   المس أي بطاقة للاستكشاف"
                                   FontFamily="Segoe UI"
                                   Foreground="White"
                                   FontSize="20"/>

                    </Border>

                </Grid>

            </Grid>

        </Viewbox>


        <!-- ================================================= -->
        <!-- CAMERAS INTERACTIVE DISPLAY -->
        <!-- ================================================= -->

        <Viewbox x:Name="CamerasContent"
                 Visibility="Collapsed"
                 Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080">

                <Grid.RowDefinitions>

                    <RowDefinition Height="145"/>
                    <RowDefinition Height="665"/>
                    <RowDefinition Height="270"/>

                </Grid.RowDefinitions>


                <!-- Header -->

                <Grid Grid.Row="0"
                      Margin="50,25,50,0">


                    <Button Width="300"
                            Height="62"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Style="{StaticResource MuseumPillButton}"
                            Padding="22,10"
                            FontSize="21"
                            Click="BackHome_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="←"
                                       Foreground="#FFD67B"
                                       FontSize="27"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <TextBlock x:Name="BackExhibitsText" Text="الصفحة الرئيسية"
                                       Foreground="White"
                                       FontSize="21"
                                       VerticalAlignment="Center"
                                       FlowDirection="RightToLeft"/>

                        </StackPanel>

                    </Button>


                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC0B0B0B"
                            BorderBrush="#8FCFA75B"
                            BorderThickness="1.5"
                            CornerRadius="30"
                            Padding="20,10">

                        <TextBlock x:Name="ItemLanguageText"
                                   Text="🌐   العربية  |  English"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="LanguageSwitch_MouseLeftButtonUp"
                                   Foreground="White"
                                   FontSize="20"/>

                    </Border>

                </Grid>


                <!-- Main selected camera -->

                <Grid Grid.Row="1"
                      Margin="50,0,50,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.75*"/>
                        <ColumnDefinition Width="0.04*"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>


                    <!-- LEFT : Image / Video -->

                    <Border Grid.Column="0"
                            CornerRadius="26"
                            BorderBrush="#E2B258"
                            BorderThickness="2.5"
                            Background="#DA080706">

                        <Grid>
<!-- Poster image -->

                            <Image x:Name="PosterImage"
       Width="0"
       Height="0"
       Opacity="0"
       IsHitTestVisible="False"
       Visibility="Collapsed"/>

<Rectangle x:Name="PosterSurface"
           RadiusX="23"
           RadiusY="23"
           Visibility="{Binding Visibility, ElementName=PosterImage}"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch">

    <Rectangle.Fill>

        <ImageBrush ImageSource="{Binding Source, ElementName=PosterImage}"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center"/>

    </Rectangle.Fill>

</Rectangle>


                            <!-- Placeholder -->

                            <Grid x:Name="PosterPlaceholder">

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <TextBlock x:Name="PosterIcon" Text="📷"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="180"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="PosterCameraName"
                                               Text="Nikon F"
                                               Foreground="#E9C989"
                                               FontSize="38"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>


                            <!-- Actual video -->

                            <MediaElement x:Name="VideoPlayer"
              Width="0"
              Height="0"
              Opacity="0"
              IsHitTestVisible="False"
              LoadedBehavior="Manual"
              UnloadedBehavior="Stop"
              Visibility="Collapsed"/>

<Rectangle x:Name="VideoSurface"
           RadiusX="23"
           RadiusY="23"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           Visibility="Collapsed"/>


                            <!-- Play button -->

                            <Button x:Name="PlayButton"
                                    Width="118"
                                    Height="118"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#B50B0B0B"
                                    Foreground="White"
                                    BorderBrush="#F0D497"
                                    BorderThickness="3"
                                    FontSize="52"
                                    Cursor="Hand"
                                    Click="PlayVideo_Click">

                                <TextBlock Text="▶"
                                           Margin="9,0,0,0"/>

                            </Button>


                            <TextBlock x:Name="MediaStatusText"
                                       Text=""
                                       Foreground="#F0D497"
                                       Background="#B0000000"
                                       Padding="15,8"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,30"
                                       Visibility="Collapsed"/>

                        </Grid>

                    </Border>


                    <!-- RIGHT : Information -->

                    <Border Grid.Column="2"
                            CornerRadius="26"
                            BorderBrush="#AAE2B258"
                            BorderThickness="1.7"
                            Background="#DF0B0B0B"
                            Padding="38">

                        <Grid FlowDirection="RightToLeft">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="145"/>

                            </Grid.RowDefinitions>


                            <TextBlock x:Name="CameraTitle"
                                       Text="Nikon F"
                                       Foreground="#F0D7A3"
                                       FontSize="58"
                                       FontWeight="Bold"
                                       TextAlignment="Right"/>


                            <TextBlock x:Name="CameraSubtitle"
                                       Grid.Row="1"
                                       Text="أيقونة التصوير في القرن العشرين"
                                       Foreground="#D8B66D"
                                       FontSize="25"
                                       Margin="0,5,0,20"
                                       TextAlignment="Right"/>


                            <Border Grid.Row="2"
                                    Background="#66CFA75B"/>


                            <TextBlock x:Name="CameraDescription"
                                       Grid.Row="3"
                                       TextWrapping="Wrap"
                                       Foreground="#E3DED5"
                                       FontSize="22"
                                       LineHeight="36"
                                       Margin="0,22,0,15"
                                       TextAlignment="Right"/>


                            <!-- Specs -->

                            <UniformGrid Grid.Row="4"
                                         Columns="4">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="السنة"
                                               Foreground="#BAA98A"
                                               FontSize="17"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="CameraYear"
                                               Text="1959"
                                               Foreground="White"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="الشركة"
                                               Foreground="#BAA98A"
                                               FontSize="17"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="CameraCompany"
                                               Text="Nikon"
                                               Foreground="White"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="النوع"
                                               Foreground="#BAA98A"
                                               FontSize="17"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="CameraType"
                                               Text="SLR 35mm"
                                               Foreground="White"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="المادة"
                                               Foreground="#BAA98A"
                                               FontSize="17"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="CameraMaterial"
                                               Text="معدن وجلد"
                                               Foreground="White"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </UniformGrid>

                        </Grid>

                    </Border>

                </Grid>
                <!-- ================================================= -->
                <!-- BOTTOM TOUCH CAMERA SLIDER -->
                <!-- ================================================= -->

                <Grid Grid.Row="2"
                      Margin="55,12,55,18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <!-- Horizontal Touch Slider -->
                    <ListBox x:Name="CameraStrip"
                             Grid.Row="0"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectedIndex="0"
