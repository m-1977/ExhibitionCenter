<Window x:Class="ExhibitionCenter.ClockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="#100B07">

    <Grid Background="#100B07">
        <Viewbox Stretch="UniformToFill">
            <Grid Width="1672" Height="941">
                <!-- Approved architecture, gold border, museum icon and title. -->
                <Image Source="pack://application:,,,/Assets/Backgrounds/ClockScreenApproved.png"
                       Stretch="UniformToFill"/>

                <StackPanel Width="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,365,0,0">
                    <TextBlock x:Name="ClockTimeText"
                               Text="10:24"
                               Foreground="#FFE1A8"
                               FontFamily="Georgia"
                               FontSize="220"
                               FontWeight="Normal"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="ClockAmPmText"
                               Text="AM"
                               Foreground="#FFE1A8"
                               FontFamily="Georgia"
                               FontSize="54"
                               TextAlignment="Center"
                               Margin="0,-30,0,0"/>

                    <Grid Width="420" Height="24" Margin="0,14,0,0">
                        <Border Height="1"
                                Background="#B88D52"
                                VerticalAlignment="Center"/>
                        <Rectangle Width="14" Height="14"
                                   Fill="#FFE1A8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="7" CenterY="7"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <TextBlock x:Name="ClockDateText"
                               Text="الأحد، 14 سبتمبر 2026"
                               Foreground="#FFE1A8"
                               FontSize="38"
                               FontWeight="Light"
                               TextAlignment="Center"
                               FlowDirection="RightToLeft"
                               Margin="0,18,0,0"/>
                </StackPanel>

                <Grid x:Name="ClockWeatherPanel"
                      Width="245"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,105,66,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ClockWeatherIcon"
                               Text="☀"
                               Foreground="#FFE1A8"
                               FontFamily="Segoe UI Symbol"
                               FontSize="66"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ClockTemperatureText"
                                   Text=""
                                   Visibility="Collapsed"
                                   Foreground="#FFE1A8"
                                   FontFamily="Georgia"
                                   FontSize="64"
                                   FontWeight="Normal"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="ClockWeatherCityText"
                                   Text="الدوحة"
                                   Foreground="#FFE1A8"
                                   FontSize="31"
                                   TextAlignment="Center"
                                   FlowDirection="RightToLeft"
                                   Margin="0,-3,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
